#variables  de entorno del backend
#el archivo .env nunca debe subirse al repositorio publico
#porque contiene datos sensibles


#puerto donde va a correr el servidor Express
PORT=4000


# datos de conexion a mysql (xampp por defecto localhost)
#usuario=root y password vacio
DB_HOST= localhost
DB_PORT= 3306
DB_USER= root
DB_PASSWORD=
DB_NAME= inventario_react


# texto secreto usado para firmar el token jwt de sesion 
# cambiarlo por cualquier cadena larga y unica en su proyecyo
JWT_SECRET = clave_secreta_curso_inventario_react
JWT_EXPIRES_IN= 8H




# Datos del usuario administrador que crea npm run seed
SEDD_ADMIN_NOMBRE=administrador
SEDD_ADMIN_EMAIL=admin@inventario.com
SEDD_ADMIN_PASSWORD=Admin123!

#comment